rules_version = '2';
// AiduxCare Clinical Intelligence Inc.
// PROD rules — piloto aiduxcare-v2-uat-dev
// Última actualización: 2026-03-29 (+ path fixes: ownerUid en isOwner; consent_status bajo patients)
// Principio: denegación implícita. Todo lo no listado está denegado.
// Auth obligatorio en todas las operaciones salvo patient_consent_tokens read (magic link).
// PHI protegido por propiedad (userId || authorUid || ownerUid) o por patientId.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funciones de utilidad ───────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.admin == true;
    }

    function matchesCurrentUser(data) {
      return isAuthenticated()
        && (data.userId == request.auth.uid
            || data.authorUid == request.auth.uid
            || data.ownerUid == request.auth.uid
            || data.professionalId == request.auth.uid
            || data.physiotherapistId == request.auth.uid
            || data.createdBy == request.auth.uid
            || data.deletedBy == request.auth.uid
            || data.resolvedBy == request.auth.uid);
    }

    function isOwner(resource) {
      return matchesCurrentUser(resource.data);
    }

    // Citas antiguas: clinicianUid guardaba email del profesional (no Firebase UID).
    function appointmentOwner(resource) {
      return isOwner(resource)
        || (isAuthenticated()
            && resource.data.clinicianUid is string
            && request.auth.token.email != null
            && resource.data.clinicianUid == request.auth.token.email);
    }

    function isArchiveOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['archived', 'archivedAt', 'archivedByUid'])
        && request.resource.data.archived == true;
    }

    function patientDocVisible(uid) {
      let p = get(/databases/$(database)/documents/patients/$(uid));
      return p.data.ownerUid == request.auth.uid
        || p.data.userId == request.auth.uid
        || p.data.authorUid == request.auth.uid;
    }

    function patientBelongsToCurrentUser(patientId) {
      return isAuthenticated()
        && patientId is string
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && patientDocVisible(patientId);
    }

    function canAccessClinicalRecord(resource) {
      return isOwner(resource)
        || patientBelongsToCurrentUser(resource.data.patientId);
    }

    function canCreateClinicalRecord() {
      return matchesCurrentUser(request.resource.data)
        || patientBelongsToCurrentUser(request.resource.data.patientId);
    }

    // ─── users ───────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;

      match /token_purchases/{purchaseId} {
        allow read, write: if isAuthenticated() && request.auth.uid == uid;
      }

      match /todayLists/{dateKey} {
        allow read, create, update, delete: if isAuthenticated()
          && request.auth.uid == uid;
      }
    }

    // ─── professional_profiles ───────────────────────────────────────────
    match /professionals/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    match /professional_profiles/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ─── patients ────────────────────────────────────────────────────────
    match /patients/{patientId} {
      allow read, write: if isAuthenticated()
        && (resource == null || isOwner(resource));
      allow create: if isAuthenticated();

      match /consent_status/{docId} {
        allow read, write: if isAuthenticated()
          && exists(/databases/$(database)/documents/patients/$(patientId))
          && patientDocVisible(patientId);
      }

      match /clinicalDecisions/{decisionId} {
        allow read, create, update: if isAuthenticated()
          && exists(/databases/$(database)/documents/patients/$(patientId))
          && patientDocVisible(patientId);
        allow delete: if false;
      }
    }

    // ─── sessions (PHI — documentación clínica) ──────────────────────────
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (resource == null || isOwner(resource));
      allow create: if isAuthenticated();
      allow update: if isOwner(resource);
      // Familia B archive — solo campos de archivo, sin tocar PHI
      allow update: if isOwner(resource) && isArchiveOnly();
      allow delete: if false; // nunca borrado físico
    }

    // ─── encounters ──────────────────────────────────────────────────────
    match /encounters/{encounterId} {
      allow read: if canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if canAccessClinicalRecord(resource);
      allow update: if canAccessClinicalRecord(resource) && isArchiveOnly();
      allow delete: if false;
    }

    // ─── consultations ───────────────────────────────────────────────────
    match /consultations/{consultationId} {
      allow read: if canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if canAccessClinicalRecord(resource);
      allow update: if canAccessClinicalRecord(resource) && isArchiveOnly();
      allow delete: if false;
    }

    // ─── clinical_baselines ──────────────────────────────────────────────
    match /clinical_baselines/{baselineId} {
      allow read: if isAuthenticated()
        && (isOwner(resource)
            || resource.data.createdBy == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && (isOwner(resource)
            || resource.data.createdBy == request.auth.uid);
      allow delete: if false;
    }

    // ─── treatment_plans ─────────────────────────────────────────────────
    match /treatment_plans/{planId} {
      allow read: if canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if canAccessClinicalRecord(resource);
      allow delete: if false;
    }

    // ─── episodes / patient_episodes ─────────────────────────────────────
    match /episodes/{episodeId} {
      allow read: if canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if canAccessClinicalRecord(resource);
      allow delete: if false;
    }

    match /patient_episodes/{episodeId} {
      allow read: if canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if canAccessClinicalRecord(resource);
      allow delete: if false;
    }

    // ─── patient_consent ─────────────────────────────────────────────────
    match /patient_consent/{consentId} {
      allow read: if isAuthenticated()
        && (resource.data.professionalId == request.auth.uid
            || resource.data.physiotherapistId == request.auth.uid
            || resource.data.userId == request.auth.uid
            || patientBelongsToCurrentUser(resource.data.patientId));
      allow create: if matchesCurrentUser(request.resource.data)
        || patientBelongsToCurrentUser(request.resource.data.patientId);
      allow update: if isAuthenticated()
        && (resource.data.professionalId == request.auth.uid
            || resource.data.physiotherapistId == request.auth.uid
            || resource.data.userId == request.auth.uid
            || patientBelongsToCurrentUser(resource.data.patientId));
      allow delete: if false;
    }

    match /patient_consent_tokens/{tokenId} {
      // Token es el secreto — patrón magic link.
      // El paciente accede sin Firebase Auth; quien tiene el ID tiene acceso.
      // Escritura restringida al fisio propietario.
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.physiotherapistId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.physiotherapistId == request.auth.uid;
      allow delete: if false;
    }

    match /consent_verifications/{verificationId} {
      allow read: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /patient_disclosures/{disclosureId} {
      allow read: if canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if canAccessClinicalRecord(resource);
      allow delete: if false;
    }

    // ─── clinical_decisions ──────────────────────────────────────────────
    match /clinical_decisions/{decisionId} {
      allow read: if canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if canAccessClinicalRecord(resource);
      allow delete: if false;
    }

    // ─── appointments ────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      allow read: if appointmentOwner(resource);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if appointmentOwner(resource);
      allow delete: if appointmentOwner(resource);
    }

    // ─── hospital_portal_notes ───────────────────────────────────────────
    match /hospital_portal_notes/{noteId} {
      allow read: if canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if canAccessClinicalRecord(resource);
      allow delete: if false;
    }

    // ─── patient_trajectory_events ───────────────────────────────────────
    match /patient_trajectory_events/{eventId} {
      allow read: if canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if canAccessClinicalRecord(resource);
      allow delete: if false;
    }

    match /patient_trace_numbers/{traceId} {
      allow read: if canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if canAccessClinicalRecord(resource);
      allow delete: if false;
    }

    // ─── pending_sms ─────────────────────────────────────────────────────
    match /pending_sms/{smsId} {
      allow read: if canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if canAccessClinicalRecord(resource);
      allow delete: if canAccessClinicalRecord(resource);
    }

    // ─── analytics / métricas (no PHI) ───────────────────────────────────
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /user_analytics/{docId} {
      allow read, write: if isAuthenticated()
        && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /user_feedback/{feedbackId} {
      allow read: if isAdmin() || isOwner(resource);
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /time_savings/{docId} {
      allow read: if isAdmin() || isOwner(resource);
      allow create: if matchesCurrentUser(request.resource.data);
      allow update: if isAdmin() || isOwner(resource);
      allow delete: if false;
    }

    match /value_analytics/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /business_metrics/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /system_analytics/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || canAccessClinicalRecord(resource);
      allow create: if canCreateClinicalRecord();
      allow update: if isAdmin() || canAccessClinicalRecord(resource);
      allow delete: if false;
    }

    // ─── compliance / auditoría ───────────────────────────────────────────
    match /compliance_audit_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (isAdmin() || matchesCurrentUser(request.resource.data));
      allow update: if false;
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin() || isOwner(resource);
      allow create: if isAuthenticated() && (isAdmin() || matchesCurrentUser(request.resource.data));
      allow update: if false;
      allow delete: if false;
    }

    match /deletion_certificates/{certId} {
      allow read: if isAdmin() || isOwner(resource);
      allow create: if isAuthenticated() && (isAdmin() || matchesCurrentUser(request.resource.data));
      allow update: if false;
      allow delete: if false;
    }

    // ─── métricas de dashboard interno ───────────────────────────────────
    match /metrics_growth/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /metrics_tech/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── SIN CATCH-ALL ────────────────────────────────────────────────────
    // Todo lo no listado está DENEGADO implícitamente.
    // Antes de añadir colecciones nuevas al código, añadir su match aquí.

  }
}
